#!/bin/bash
# Switch the llm VM between normal mode (fast + router) and agent mode
# (router only, so qwen27-agent gets the whole card). GPU-VM.md F5.
# Installed to /usr/local/sbin/llm-mode; run with sudo.
set -euo pipefail
U=http://127.0.0.1:8080
K=$(head -n1 /etc/llama/api-keys)

unload() {
  curl -fsS -H "Authorization: Bearer $K" \
    -H 'Content-Type: application/json' \
    -d "{\"model\":\"$1\"}" "$U/models/unload" >/dev/null 2>&1 || true
}

case "${1:-}" in
  agent)
    systemctl stop llama-fast
    echo "llama-fast stopped; request model qwen27-agent on :8080"
    ;;
  normal)
    unload qwen27-agent
    sleep 5
    systemctl start llama-fast
    echo "qwen27-agent unloaded; llama-fast started"
    ;;
  status)
    echo "llama-fast:   $(systemctl is-active llama-fast || true)"
    echo "llama-router: $(systemctl is-active llama-router || true)"
    curl -fsS -H "Authorization: Bearer $K" "$U/models" \
      | jq -r '.data[] | "\(.id)\t\(.status.value)"'
    ;;
  *)
    echo "usage: llm-mode agent|normal|status" >&2
    exit 2
    ;;
esac
