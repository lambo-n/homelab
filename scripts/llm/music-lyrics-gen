#!/bin/bash
# Generate a song with MiniMax Music 3 (Q8_0 components) on the B70 through
# audio.cpp's SYCL build. GPU-VM.md → Music generation.
# Installed to /usr/local/bin/music-lyrics-gen; run as dev (render group), after
# `sudo llm-mode music-lyrics`.
# usage: music-lyrics-gen "<style description>" "<lyrics>" [seconds] [seed]
set -euo pipefail

if [ $# -lt 2 ]; then
  echo 'usage: music-lyrics-gen "<style>" "<lyrics>" [seconds] [seed]' >&2
  exit 2
fi
# A router preset or FLUX.2 beside this would run the card out of memory.
for u in llama-router sd-server; do
  if systemctl -q is-active "$u"; then
    echo "$u holds the card; run: sudo llm-mode music-lyrics" >&2
    exit 1
  fi
done

M=/models/minimax-music3
out=/models/music/$(date +%Y%m%d-%H%M%S).wav
seed=${4:-$((RANDOM * 32768 + RANDOM))}
export ONEAPI_DEVICE_SELECTOR=level_zero:gpu
# oneDNN matmuls turn this model's output into constant full-scale noise on
# SYCL; ggml's own kernels are correct and no slower.
export GGML_SYCL_DISABLE_DNN=1

/usr/local/bin/llama-oneapi \
  /models/src/audio.cpp/build-sycl/bin/audiocpp_cli \
  --task gen --family minimax_music3 --model "$M" \
  --backend sycl --threads 8 \
  --session-option \
    minimax_music3.language_model_gguf=language_model_q8_0.gguf \
  --session-option \
    minimax_music3.rvq_depth_decoder_gguf=rvq_depth_decoder_q8_0.gguf \
  --session-option \
    minimax_music3.flow_transformer_gguf=transformer_q8_0.gguf \
  --text "$1" \
  --request-option "lyrics=$2" \
  --request-option "duration_sec=${3:-30}" \
  --request-option "seed=$seed" \
  --out "$out" --metrics
echo "saved $out (seed $seed)"
