#!/bin/bash
# Collect llama-server metrics for every model on VM 105 into node_exporter's
# textfile collector, labelled by model, plus the card's mode (llm-mode), VRAM
# in use and image mode's counters. Run by llama-metrics.timer every 15 s.
# Installed to /usr/local/sbin/llama-metrics. GPU-VM.md F6b.
#
# Why not scrape the router directly: in router mode /metrics needs ?model=, and a
# preset that isn't loaded answers 400, so each unloaded preset would be a
# permanently down Prometheus target (and a permanently firing TargetDown). Here an
# unloaded preset is simply llamacpp:model_loaded{model="…"} 0.
#
# Only presets the router reports as loaded are queried, and with autoload=false
# as a second guard: a metrics read must never load a model and evict the one in
# use. Router GETs also don't refresh a model's last-used time (only POSTs do), so
# this can't change which model the router evicts next.
set -uo pipefail

DIR=/var/lib/prometheus/node-exporter
OUT="$DIR/llama.prom"
KEY=$(head -n1 /etc/llama/api-keys)
# Header via a file descriptor so the key never appears in a process listing.
hdr() { printf 'Authorization: Bearer %s' "$KEY"; }

tmp=$(mktemp "$DIR/.llama.prom.XXXXXX")
trap 'rm -f "$tmp"' EXIT

emit() { # <model> <url>
  local body
  if body=$(curl -fsS -m 5 -H @<(hdr) "$2" 2>/dev/null); then
    echo "llamacpp:model_loaded{model=\"$1\"} 1"
    # llama-server's metrics carry no labels: "name value". Drop HELP/TYPE lines
    # (repeating them per model is invalid in one file); rate() doesn't need them.
    printf '%s\n' "$body" \
      | awk -v m="$1" '!/^#/ && NF == 2 { print $1 "{model=\"" m "\"} " $2 }'
  else
    echo "llamacpp:model_loaded{model=\"$1\"} 0"
  fi
}

{
  emit fast "http://127.0.0.1:8081/metrics"
  if models=$(curl -fsS -m 5 -H @<(hdr) "http://127.0.0.1:8080/models" 2>/dev/null); then
    while read -r id status; do
      if [ "$status" = loaded ]; then
        emit "$id" "http://127.0.0.1:8080/metrics?model=$id&autoload=false"
      else
        echo "llamacpp:model_loaded{model=\"$id\"} 0"
      fi
    done < <(printf '%s' "$models" | jq -r '.data[] | "\(.id) \(.status.value)"')
  fi

  # Which mode the card is in (llm-mode): exactly one of these is 1.
  fast=$(systemctl is-active llama-fast)
  router=$(systemctl is-active llama-router)
  sd=$(systemctl is-active sd-server)
  mode=other
  if [ "$sd" = active ]; then mode=image
  elif [ "$fast" = active ] && [ "$router" = active ]; then mode=normal
  elif [ "$router" = active ]; then mode=agent
  fi
  for m in normal agent image other; do
    echo "llm_mode{mode=\"$m\"} $([ "$m" = "$mode" ] && echo 1 || echo 0)"
  done
  echo "sd_server_up $([ "$sd" = active ] && echo 1 || echo 0)"

  # VRAM in use, from Intel's xpu-smi (~0.3 s); hwmon has temps and power only.
  if vram=$(xpu-smi stats -d 0 -j 2>/dev/null \
      | jq -e '.memory.used_mib.tile_0.current * 1048576 | floor'); then
    echo "llm_gpu_vram_used_bytes $vram"
  fi

  # sd-proxy's counters; the file exists only while image mode is on.
  cat /run/sd-proxy/sd.prom 2>/dev/null
} > "$tmp"

chmod 644 "$tmp"
mv "$tmp" "$OUT"
trap - EXIT
