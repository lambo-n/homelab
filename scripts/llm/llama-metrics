#!/bin/bash
# Collect llama-server metrics for every model on VM 105 into node_exporter's
# textfile collector, labelled by model, plus the card's mode (llm-mode), VRAM
# in use and image mode's counters. Run by llama-metrics.timer every 15 s.
# Installed to /usr/local/sbin/llama-metrics. GPU-VM.md F6b.
#
# Why not scrape the router directly: in router mode /metrics needs ?model=, and a
# preset that isn't loaded answers 400, so each unloaded preset would be a
# permanently down Prometheus target (and a permanently firing TargetDown). Here an
# unloaded preset is simply llamacpp:model_loaded{model="…"} 0.
#
# Only presets the router reports as loaded are queried, and with autoload=false
# as a second guard: a metrics read must never load a model and evict the one in
# use. Router GETs also don't refresh a model's last-used time (only POSTs do), so
# this can't change which model the router evicts next.
set -uo pipefail

DIR=/var/lib/prometheus/node-exporter
OUT="$DIR/llama.prom"
KEY=$(head -n1 /etc/llama/api-keys)
# Header via a file descriptor so the key never appears in a process listing.
hdr() { printf 'Authorization: Bearer %s' "$KEY"; }

tmp=$(mktemp "$DIR/.llama.prom.XXXXXX")
trap 'rm -f "$tmp"' EXIT

emit() { # <model> <url>
  local body
  if body=$(curl -fsS -m 5 -H @<(hdr) "$2" 2>/dev/null); then
    echo "llamacpp:model_loaded{model=\"$1\"} 1"
    # llama-server's metrics carry no labels: "name value". Drop HELP/TYPE lines
    # (repeating them per model is invalid in one file); rate() doesn't need them.
    printf '%s\n' "$body" \
      | awk -v m="$1" '!/^#/ && NF == 2 { print $1 "{model=\"" m "\"} " $2 }'
  else
    echo "llamacpp:model_loaded{model=\"$1\"} 0"
  fi
}

{
  emit fast "http://127.0.0.1:8081/metrics"
  if models=$(curl -fsS -m 5 -H @<(hdr) "http://127.0.0.1:8080/models" 2>/dev/null); then
    while read -r id status; do
      if [ "$status" = loaded ]; then
        emit "$id" "http://127.0.0.1:8080/metrics?model=$id&autoload=false"
      else
        echo "llamacpp:model_loaded{model=\"$id\"} 0"
      fi
    done < <(printf '%s' "$models" | jq -r '.data[] | "\(.id) \(.status.value)"')
  fi

  # Which mode the card is in (llm-mode): exactly one of these is 1.
  fast=$(systemctl is-active llama-fast)
  router=$(systemctl is-active llama-router)
  sd=$(systemctl is-active sd-server)
  mode=other
  if [ "$sd" = active ]; then mode=image
  elif [ "$fast" = active ] && [ "$router" = active ]; then mode=normal
  elif [ "$router" = active ]; then mode=agent
  fi
  for m in normal agent image other; do
    echo "llm_mode{mode=\"$m\"} $([ "$m" = "$mode" ] && echo 1 || echo 0)"
  done
  echo "sd_server_up $([ "$sd" = active ] && echo 1 || echo 0)"

  # Image mode as a preset beside the llama ones, so the dashboard's per-model
  # row repeats for flux2-dev too. sd-server has no /metrics: loaded is
  # sd-proxy's /health, and busy and the stage timings come from its own log
  # (this run only, so a restart clears them). Busy covers every API, the
  # async /sdcpp/v1 jobs included, which sd-proxy can't see until they finish.
  sd_loaded=0 sd_busy=0
  if [ "$sd" = active ]; then
    curl -fs -o /dev/null -m 2 http://127.0.0.1:8082/health && sd_loaded=1
    inv=$(systemctl show -p InvocationID --value sd-server)
    sdm=$(journalctl _SYSTEMD_INVOCATION_ID="$inv" -o cat --no-pager -n 400 \
      2>/dev/null | awk '
      function taking(s) {  # "taking 32.34s" or "taking 2 ms" -> seconds
        if (!match(s, /taking [0-9.]+ ?m?s/)) return 0
        s = substr(s, RSTART + 7, RLENGTH - 7)
        return (s ~ /ms$/) ? s / 1000 : s + 0
      }
      # A generation: encode the prompt (text encoder), sample (diffusion
      # model, one bar step per sampling step), decode (VAE). Each stage
      # first moves its weights onto the card ("loading tensors"); that is
      # its own stage here, taken out of the other three. Values are kept
      # from the last generation that completed.
      /generate_image [0-9]+x[0-9]+/ {
        busy = 1; ph = "enc"; delete w; enc = smp = dec = 0; nb = 0; bstep = ""
      }
      /^\[E\]/ { busy = 0; ph = "" }
      /loading tensors completed, taking/ { w[ph] += taking($0) }
      /get_learned_condition completed, taking/ { enc = taking($0) - w["enc"] }
      /generating image: / { ph = "smp" }
      ph == "smp" && /(s\/it|it\/s)/ {
        # The sampling bar: "n/m - 10.25s/it" per step, or it/s when fast.
        # Step 1 also builds the graph (~75 s), so speed is from step 2 on.
        delete per; s = $0; m = 0
        while (match(s, /[0-9]+\/[0-9]+ - [0-9.]+(s\/it|it\/s)/)) {
          tok = substr(s, RSTART, RLENGTH); s = substr(s, RSTART + RLENGTH)
          split(tok, a, /[\/ ]+/); v = a[4] + 0
          if (tok ~ /it\/s$/) v = v > 0 ? 1 / v : 0
          per[a[1] + 0] = v; m = a[2] + 0
        }
        nb = m; bs = bn = 0
        for (i = 2; i <= m; i++) if (i in per) { bs += per[i]; bn++ }
        bstep = bn ? bs / bn : ""
      }
      /sampling completed, taking/ { smp = taking($0) - w["smp"]; ph = "dec" }
      /decode_first_stage completed, taking/ { dec = taking($0) - w["dec"] }
      /generate_image completed in / {
        busy = 0; ph = ""; done = 1
        o_enc = enc; o_smp = smp; o_dec = dec
        o_w = w["enc"] + w["smp"] + w["dec"]; o_steps = nb; o_step = bstep
      }
      END {
        print "sd_busy " (busy ? 1 : 0)
        if (!done) exit
        printf "sd_stage_seconds{stage=\"encode\"} %.3f\n", o_enc
        printf "sd_stage_seconds{stage=\"weights\"} %.3f\n", o_w
        printf "sd_stage_seconds{stage=\"sample\"} %.3f\n", o_smp
        printf "sd_stage_seconds{stage=\"decode\"} %.3f\n", o_dec
        print "sd_sampling_steps " o_steps
        if (o_step != "") printf "sd_step_seconds %.3f\n", o_step
      }')
    printf '%s\n' "$sdm"
    case $sdm in *"sd_busy 1"*) sd_busy=1 ;; esac
  fi
  # Under the llama names on purpose: the per-model row's Status and
  # Requests panels then work for the image preset unchanged.
  echo "llamacpp:model_loaded{model=\"flux2-dev\"} $sd_loaded"
  echo "llamacpp:requests_processing{model=\"flux2-dev\"} $sd_busy"

  # VRAM in use, from Intel's xpu-smi (~0.3 s); hwmon has temps and power only.
  if vram=$(xpu-smi stats -d 0 -j 2>/dev/null \
      | jq -e '.memory.used_mib.tile_0.current * 1048576 | floor'); then
    echo "llm_gpu_vram_used_bytes $vram"
  fi

  # sd-proxy's counters; the file exists only while image mode is on.
  cat /run/sd-proxy/sd.prom 2>/dev/null
} > "$tmp"

chmod 644 "$tmp"
mv "$tmp" "$OUT"
trap - EXIT
