# Install: GPU-VM.md Observability. A full jfk.wav transcription is heavier
# than a metrics scrape, so this runs slower than llama-metrics.timer's 15 s.
# Prometheus scrapes node_exporter every 60 s; 30 s keeps every scrape at most
# 30 s behind.
[Unit]
Description=Check whisper-server GPU/CPU status every 30 s

[Timer]
OnBootSec=45s
OnUnitActiveSec=30s
AccuracySec=1s

[Install]
WantedBy=timers.target
