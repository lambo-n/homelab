# Install: VOICE.md V1. Speech-to-text for the voice satellite, on the B70.
# Loopback only: whisper-server has no API key option, so nothing but the
# Wyoming bridge on this VM (wyoming-whisper.service) may reach it.
[Unit]
Description=whisper.cpp server (small.en f16) on 127.0.0.1:8910 (homelab VOICE.md V1)
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/models

[Service]
# Same user and GPU groups as llama-fast/llama-router, and the same oneAPI
# wrapper: this is a third SYCL client of the one card.
User=llama
Group=llama
SupplementaryGroups=render video
# Model: f16 small.en, NOT q8_0. On this build (v1.9.4, SYCL, GGML_SYCL_F16)
# q8_0 transcribed jfk.wav as single garbage words ("chapel", "matching") with
# flash attention on or off, while the same file was correct on CPU and f16 was
# correct on the card at 0.21 s warm (VOICE.md V1f, 2026-09-17).
#
# VRAM: measured 27,221 of 32,656 MiB used with qwen27 (65,536), fast and the
# q8_0 model loaded; f16 adds ~220 MiB of weights. Fallback: `-ng -t 8` (CPU,
# 1.84 s for jfk.wav's 11 s of audio).
ExecStart=/usr/local/bin/llama-oneapi \
  /models/src/whisper.cpp/build-sycl/bin/whisper-server \
  --host 127.0.0.1 --port 8910 \
  -m /models/whisper/ggml-small.en.bin \
  -t 4
# Warm-up: the first request after start pays ~34 s of SYCL kernel compilation.
# Pay it here, not on the first "okay nabu" after a boot. `-` keeps a failed
# warm-up from failing the unit; wyoming-whisper (After=) starts once this ends.
ExecStartPost=-/bin/sh -c 'for i in $$(seq 60); do \
  curl -sf -o /dev/null -F file=@/models/src/whisper.cpp/samples/jfk.wav \
  http://127.0.0.1:8910/inference && exit 0; sleep 2; done; exit 1'
TimeoutStartSec=300
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
