# Copy to terraform.tfvars (gitignored) ONLY if you cannot use environment
# variables. Preferred instead:
#
#   export CLOUDFLARE_API_TOKEN=...      # read natively by the provider
#   export PROXMOX_VE_API_TOKEN=...
#
# which keeps both tokens off disk entirely. The one value you do need here is
# the zone id, which is not secret.

cloudflare_zone_id = "..."  # sunosrs.cc -- see README.md step 3
