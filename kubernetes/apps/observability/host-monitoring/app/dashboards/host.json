      "type": "stat",
      "title": "SMART health",
      "id": 16,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "smartctl_device_smart_status: 1 passed, 0 failed. HostDriveSmartFailed fires on 0.",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 21
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "smartctl_device_smart_status{instance=\"pve\"} * on (instance, device) group_left (model_name, serial_number) smartctl_device{instance=\"pve\"}",
