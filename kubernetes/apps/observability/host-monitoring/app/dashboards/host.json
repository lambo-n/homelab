    {
      "type": "table",
      "title": "Media errors",
      "id": 18,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "SAS: grown defects and uncorrected read/write errors. SATA: attributes 5, 197, 198 (raw). All should be 0.",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 21
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "smartctl_scsi_grown_defect_list{instance=\"pve\"} * on (instance, device) group_left (model_name, serial_number) smartctl_device{instance=\"pve\"}",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
