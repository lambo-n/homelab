      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "smartctl_device_temperature{instance=\"pve\", temperature_type=\"current\"} * on (instance, device) group_left (model_name, serial_number) smartctl_device{instance=\"pve\"}",
