        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Tokens generated ÷ time spent generating, over the last 5 minutes. Idle when nothing was generated.",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 4,
        "y": 25
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "(sum(increase(llamacpp:tokens_predicted_total{instance=\"llm\", job=\"scrapeConfig/observability/llm-node\", model=\"$model\"}[5m])) / sum(increase(llamacpp:tokens_predicted_seconds_total{instance=\"llm\", job=\"scrapeConfig/observability/llm-node\", model=\"$model\"}[5m]))) and (sum(increase(llamacpp:tokens_predicted_seconds_total{instance=\"llm\", job=\"scrapeConfig/observability/llm-node\", model=\"$model\"}[5m])) > 0)",
          "legendFormat": "",
          "refId": "A",
          "range": false,
